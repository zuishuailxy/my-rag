# ============================================================
# 环境变量模板：复制为 .env 后按需修改
#   cp .env.example .env
# docker-compose.yml 中以 ${VAR:-默认值} 方式引用
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=my_rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_pg_123

# ---- MongoDB（文档正文，对应 init-scripts/mongodb/init.js 创建的应用账号）----
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=knowledge_hub_user
MONGO_PASSWORD=knowledge_hub_password
MONGO_DB=knowledge_hub
MONGO_AUTH_SOURCE=knowledge_hub

# ---- Neo4j ----
NEO4J_PASSWORD=rag_neo4j_123

# ---- RustFS（S3 兼容对象存储，替代 MinIO；与 docker-compose.yml 中 rustfs 服务一致）----
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# ---- LangFuse ----
LANGFUSE_SECRET=please_change_me

# ---- 应用服务（--profile app 时使用，应用镜像内读取）----
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# EMBEDDING_MODEL=text-embedding-v3
# LLM_MODEL=qwen-max
