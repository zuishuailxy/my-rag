# ============================================================
# 环境变量模板：复制为 .env 后按需修改
#   cp .env.example .env
# docker-compose.yml 中以 ${VAR:-默认值} 方式引用
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=my_rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_pg_123

# ---- MongoDB（文档正文，对应 init-scripts/mongodb/init.js 创建的应用账号）----
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USER=knowledge_hub_user
MONGO_PASSWORD=knowledge_hub_password
MONGO_DB=knowledge_hub
MONGO_AUTH_SOURCE=knowledge_hub

# ---- Neo4j ----
NEO4J_PASSWORD=rag_neo4j_123

# ---- RustFS（S3 兼容对象存储，替代 MinIO；与 docker-compose.yml 中 rustfs 服务一致）----
RUSTFS_ENABLED=true
# 本地开发走宿主机映射端口 9000；容器内由 compose 覆盖为 http://rustfs:9000
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=knowledge-hub
# 对外可访问基址（如经 nginx/CDN 时），缺省用 RUSTFS_ENDPOINT
# RUSTFS_PUBLIC_URL=https://files.example.com

# ---- LangFuse ----
LANGFUSE_SECRET=please_change_me

# ---- RabbitMQ（发布后异步管线；与 docker-compose.yml 中 rabbitmq 服务一致）----
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_CONNECT_TIMEOUT_MS=15000

# ---- Embedding（发布索引向量；DashScope 百炼 OpenAI 兼容端点）----
EMBEDDING_PROVIDER=local   # local=确定性伪向量(开发/测试) | openai=DashScope API
# API Key（任选其一，优先级 EMBEDDING_API_KEY > DASHSCOPE_API_KEY > OPENAI_API_KEY）
# DASHSCOPE_API_KEY=sk-xxxx
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=qwen3.7-text-embedding   # 以百炼控制台模型 ID 为准
# EMBEDDING_DIMENSION=1024
# EMBEDDING_BATCH_SIZE=10   # DashScope 单次上限，超出自动钳制

# ---- 应用服务（--profile app 时使用，应用镜像内读取）----
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LLM_MODEL=qwen-max
