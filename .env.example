# ============================================================
# 环境变量模板（基础设施层）：docker-compose.yml 以 ${VAR:-默认值} 方式引用
#   cp .env.example .env   # 后按需修改，不创建 .env 则全部使用默认值
#
# 注意：
# - 本文件只管容器凭据 / 存储路径；应用自身配置（FastAPI、LLM、ES 连接等）见 backend/.env.example
# - 修改数据库密码后，记得同步 backend/.env 中对应的连接配置
#
# ⚠️ 下方口令是**本地开发的默认值，不是密钥**（与 docker-compose.yml 的 ${VAR:-默认值}
#    逐项对应，改这里等于改默认行为）。它们随仓库公开是安全的 —— 对外暴露的机器上
#    这些端口本身也不该直接开放。真部署请在 .env 里改成强口令并同步 backend/.env。
# ============================================================

# ---- 通用 ----
# 数据卷宿主机目录（默认当前目录下的 ./volumes）
# DOCKER_VOLUME_DIRECTORY=/data/knowledge_hub

# ---- PostgreSQL ----
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=knowledge_hub

# ---- MongoDB（root 账号；应用账号由 init-scripts/mongodb/init.js 创建）----
MONGO_INITDB_ROOT_USERNAME=mongo_user
MONGO_INITDB_ROOT_PASSWORD=mongo_pass123
MONGO_INITDB_DATABASE=knowledge_hub
# mongo-express 网页登录账号（区分数据库账号）
ME_ADMIN_USERNAME=me_admin
ME_ADMIN_PASSWORD=me_123456

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# ---- RustFS（S3 兼容对象存储）----
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# ---- Neo4j（KG 知识图谱；账号固定 neo4j）----
NEO4J_PASSWORD=12345678

# ---- 可观测（Langfuse 自托管）----
# 独立栈，不读本文件：docker compose --env-file .env.langfuse -f docker-compose.langfuse.yml up -d
# 应用侧 Key 见 backend/.env.example 的 LANGFUSE_* 段
