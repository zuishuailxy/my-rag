# 复制为 .env 后使用
APP_NAME=企业智能知识库系统
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1
# 业务日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL（大小写不敏感，拼错回退 INFO）
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=knowledge_hub

# ---- 数据库 SQL 日志（SQLAlchemy echo；true 会把每条 SQL 打进日志）----
DB_ECHO=false

CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ---- 文档发布审核（true=发布需审核；只有严格写 false 才免审）----
DOCUMENT_REQUIRE_APPROVAL=true

# ---- Embedding（发布索引向量；DashScope 百炼 OpenAI 兼容端点）----
# 注意：DASHSCOPE_API_KEY 是占位值，填好真实 key 前发布/索引的向量调用会 401；
# 想离线跑测试就把 EMBEDDING_PROVIDER 改回 local
EMBEDDING_PROVIDER=openai
DASHSCOPE_API_KEY=sk-你的真实key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=10

# ---- Elasticsearch（全文/关键词检索；向量存 PG，不写 dense_vector）----
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_NODE=http://localhost:9200

# ---- 混合检索 / 重排（DashScope text-rerank）----
# rerank 分数下限：**与所选 reranker 模型绑定**。gte-rerank-v2 实测相关约 0.13~0.47、
# 无关约 0.006，故取 0.1；若换 qwen3-rerank 需重新校准。
RAG_MIN_SCORE=0.1

# ---- KG 抽取（LLM 实体/关系抽取；DeepSeek OpenAI 兼容端点）----
# API Key fallback：OPENAI_API_KEY → LLM_API_KEY → DASHSCOPE_API_KEY
LLM_API_KEY=sk-你的DeepSeek-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
KG_MAX_ENTITIES=12
KG_MAX_RELATIONS=15
KG_LLM_TIMEOUT_MS=60000

# ---- Neo4j（KG 知识图谱存储；与 docker-compose 中 neo4j 服务一致）----
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

# ---- 邮箱验证（默认 false：注册后立即可登录；true 时需邮件激活）----
REQUIRE_EMAIL_VERIFICATION=false
APP_PUBLIC_URL=http://localhost:3000

# ---- SMTP 邮件----
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=xx@xx.com
MAIL_PASS=xx
MAIL_FROM="Knowledge Hub <xx@xx.com>"

# ---- Redis（密码重置验证码等；compose 中 redis:7-alpine 无密码）----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# search key
TAVILY_API_KEY=

# ---- TypeSafe 结构化判定（意图识别；未配置则回退 LLM 判断）----
TYPESAFE_API_KEY=

# ---- 检索改写----
# 改写 LLM 超时（毫秒）；超时/失败一律回退原问题，不阻断检索。
AI_QUERY_REWRITE_TIMEOUT_MS=15000

# ---- 对话短期记忆----
# 最近 N 条 human/ai 原文缓存进 Redis，miss 时回落 kh_ai_message 回填。
# 只存原文：检索资料 / 思考 / 工具消息 / Mem0 系统消息都不进窗口。
CHAT_SHORT_MEMORY_TTL_SECONDS=86400
CHAT_SHORT_MEMORY_MAX_MESSAGES=20
CHAT_SHORT_MEMORY_KEY_PREFIX=kh:chat

# ---- 会话滚动摘要（滑出热窗口的旧历史 → 增量折叠；Redis + Postgres 双写）----
# 摘要目标字数（超限硬截断）。热窗口 20 条 ≈ 1500~2500 token，摘要占 ~15% 合理。
CHAT_SUMMARY_MAX_CHARS=400

# ---- 对话长期记忆----
# 留空 MEM0_API_KEY = 整个长期记忆模块跳过（不影响对话）。
# ⚠️ 记忆抽取在 Mem0 云侧完成（模型不可选），本进程只跑分类器（走 LLM_API_KEY 链）。
MEM0_API_KEY=
MEM0_HOST=
MEM0_TOP_K=5

# LangSmith (LangChain Agent/对话链路追踪)。不配 Key 则不上报。
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=knowledge-hub

# ---- 多模态图像识别（图片 OCR；Qwen-VL via DashScope 兼容口）----
# 图片文件（jpg/png/webp/bmp/gif）走视觉模型 OCR → Markdown，再分块入索引。
# Key fallback：VISION_API_KEY → DASHSCOPE_API_KEY → OPENAI_API_KEY。
# 未配置 Key 时上传图片会明确返回 400（而非 500）。
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=qwen-vl-max
VISION_TIMEOUT_MS=60000
